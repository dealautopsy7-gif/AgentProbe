PORT=8787

# Supabase (server-side: service role key, never expose to the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Same publishable/anon key the frontend ships — safe here, used so the
# public share page's reads are actually enforced by RLS.
SUPABASE_ANON_KEY=

# Where the frontend runs — only used for the public share page's CTA link.
FRONTEND_URL=http://localhost:5173

# Direct Postgres connection (Supabase Dashboard -> Project Settings -> Database).
# Not read by the app itself — only for running migrations directly:
# psql "$DATABASE_URL" -f db/migrations/000X_*.sql
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Redis (BullMQ). `docker-compose up redis` in this folder, or any local Redis.
REDIS_URL=redis://localhost:6379

# 'stub' (default) fakes attempt outcomes — no agent/browser calls, no cost —
# so the API/queue/worker/DB pipeline can be verified end to end. Switch to
# 'live' only once the fields for your chosen BROWSER_PROVIDER below are
# filled in and the Day-1 cost gate (`npm run gate`) has passed.
AGENT_MODE=stub

# Which BrowserProvider the live path uses.
#   local       - real Chromium on this machine, Stagehand + AICredits.
#                 No cloud browser cost. Default. Needs only AICREDITS_API_KEY.
#   steel       - self-hosted Steel.dev + real Gemini computer-use.
#   browserbase - hosted fallback (NOT YET IMPLEMENTED — throws if selected,
#                 see server/src/agent/providers/BrowserbaseBrowserProvider.ts).
BROWSER_PROVIDER=local
# Optional: explicit Chrome/Chromium executable path for local mode. Leave
# blank to let Stagehand's chrome-launcher auto-detect.
LOCAL_CHROME_PATH=

# Which LLM does the *reasoning* for the local live agent loop.
#   aicredits - AICredits.in (default). The only path proven end to end.
#   gemini    - Google Gemini called directly. Built and wired, but has
#               NEVER made a real call (no funded key yet) — expect to
#               debug it on first use. See LIVE-READINESS.md.
# Orthogonal to BROWSER_PROVIDER (this picks the brain, that picks the
# browser). Only consulted when BROWSER_PROVIDER=local.
AGENT_LLM_PROVIDER=aicredits

# Gemini API key. Needed for AGENT_LLM_PROVIDER=gemini, and/or for
# BROWSER_PROVIDER=steel|browserbase. Must be from a project with billing
# funded — free-tier keys 0-quota-fail.
GEMINI_API_KEY=

# TWO DIFFERENT GEMINI MODELS, TWO DIFFERENT JOBS — don't conflate them:
#   GEMINI_AGENT_MODEL        general vision+reasoning model, used when
#                             AGENT_LLM_PROVIDER=gemini on the local
#                             Stagehand path (Stagehand does the clicking;
#                             this model only decides what to do next).
#   GEMINI_COMPUTER_USE_MODEL the dedicated computer-use model that emits
#                             click coordinates itself — used ONLY by the
#                             steel/browserbase path
#                             (src/agent/drivers/GeminiComputerUseDriver.ts).
# Verify current model ids at https://ai.google.dev before a real run.
GEMINI_AGENT_MODEL=gemini-2.5-pro
GEMINI_COMPUTER_USE_MODEL=

# Hosted browser — Steel.dev (self-hosted via docker-compose) or cloud.
# Only needed if BROWSER_PROVIDER=steel.
STEEL_API_URL=http://localhost:3000
STEEL_API_KEY=

# Browserbase — only needed if BROWSER_PROVIDER=browserbase (and even then,
# the provider class itself isn't implemented yet — see note above).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Supabase Storage bucket for run recordings. Must exist before a live run
# can save video (create it once via the dashboard or the storage API —
# it does not get created automatically).
VIDEO_STORAGE_BUCKET=run-videos

# Email alerts (score-drop notifications). Without this, alerts still write
# to the `alerts` table; the email step just logs "would send" and returns
# false instead of crashing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AgentProbe <alerts@agentprobe.dev>

# Live fix generation. getFixGenerator() tries AICREDITS_API_KEY first, then
# DEEPSEEK_API_KEY, then falls back to the templated (no-API) generator.
# Both are fully optional — a missing/failing key never breaks a run's fix
# list, it just falls back one tier.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# AICredits.in — INR-billed OpenAI-compatible gateway. Two separate uses:
# (1) AICREDITS_MODEL for cheap fix-generation text calls, (2)
# AICREDITS_AGENT_MODEL for the live agent loop's reasoning when
# AGENT_LLM_PROVIDER=aicredits (needs real vision+reasoning quality, not
# the cheapest model).
# IMPORTANT: use response_format "json_object", not "json_schema" — the
# latter silently returns an empty completion on this gateway's Gemini
# route (real tokens spent, no output). See AICreditsLLMClient.ts.
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_MODEL=google/gemini-3.1-flash-lite
AICREDITS_AGENT_MODEL=google/gemini-2.5-pro

# Stripe — fully optional, unrelated to AGENT_MODE. Without these,
# POST /billing/checkout and POST /stripe/webhook answer honestly that
# payments aren't wired up yet, rather than crashing or faking success.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_AGENCY=

# How often the worker checks the schedules table for due recurring scans.
SCHEDULER_TICK_MS=60000

# Day-1 gate script target (npm run gate). Keep this read-only — the whole
# point is measuring cost without any cart/checkout risk.
GATE_TARGET_URL=https://www.allbirds.com
GATE_TARGET_GOAL=Find one shoe product and read its price. Do not add anything to a cart or attempt to check out — just locate a product and read the price, then stop.
